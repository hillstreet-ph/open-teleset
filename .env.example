# =============================================================================
# open-teleset production environment — NEVER commit real values
# Copy to .env and fill via your secret manager / CI secrets
# =============================================================================

APP_ENV=production
APP_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Telegram (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Session encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SESSION_ENCRYPTION_KEY=

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_POOLER_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres

# Redis (optional but recommended for scheduler + cache)
REDIS_URL=redis://redis:6379/0

# Cloudflare R2 / S3-compatible storage (optional — media & exports)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=open-teleset
S3_REGION=auto

# Dashboard auth (basic protection)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-strong-password

# Feature flags
ENABLE_HEALTH_MONITOR=true
HEALTH_CHECK_INTERVAL_SECONDS=300
ENABLE_SCHEDULER=true
