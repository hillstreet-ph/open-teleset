# Open-Teleset production runtime only. Do not commit real values.
# Store values on the verified Zeabur service; see docs/DEPLOYMENT_RUNBOOK.md.
# Google/GitHub client secrets belong in Supabase Auth, not this file.
APP_ENV=production
DASHBOARD_USER=admin
# Optional public username alias for an existing Supabase email identity.
# Sign-in still requires that identity's Supabase password.
DASHBOARD_LOGIN_EMAIL=
APP_BASE_URL=https://open-teleset.site
ALLOWED_ORIGINS=https://open-teleset.site,https://www.open-teleset.site,https://app.open-teleset.site
PORT=8080
LOG_LEVEL=INFO

SUPABASE_URL=https://hoseohvgoiarxluxqwqv.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Prefer the provider-issued Supavisor connection string for this project.
# Leave DATABASE_URL empty when using DATABASE_POOLER_URL. Never guess the host.
DATABASE_POOLER_URL=
DATABASE_URL=
SUPABASE_JWT_ISSUER=https://hoseohvgoiarxluxqwqv.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SESSION_ENCRYPTION_KEY=
SESSION_ENCRYPTION_KEY_VERSION=1
MCP_SERVER_API_KEY=

REDIS_URL=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=open-teleset-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
