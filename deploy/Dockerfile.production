# open-teleset production image
FROM python:3.12-slim AS builder
ENV PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY requirements-prod.txt .
RUN pip install --upgrade pip && pip install --prefix=/install -r requirements-prod.txt

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src:/app APP_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl libssl-dev && rm -rf /var/lib/apt/lists/*
COPY --from=builder /install /usr/local
COPY src/ /app/src/
COPY deploy/ /app/deploy/
COPY static/ /app/static/
COPY migrations/ /app/migrations/
COPY scripts/ /app/scripts/
COPY supabase/ /app/supabase/
COPY dashboard.py main.py VERSION /app/
COPY account_manager.py proxy_manager.py health_monitor.py /app/
COPY stats_tracker.py log_manager.py template_manager.py /app/
COPY scheduler.py batch_operations.py /app/
COPY requirements-prod.txt /app/
RUN useradd -m -u 10001 -s /bin/false appuser && chown -R appuser:appuser /app && mkdir -p /app/accounts && chown appuser:appuser /app/accounts && chmod -R 555 /app/src /app/static /app/deploy
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD curl -fsS http://127.0.0.1:8080/health || exit 1
LABEL org.opencontainers.image.source="https://github.com/hillstreet-ph/open-teleset" org.opencontainers.image.description="open-teleset production image" org.opencontainers.image.licenses="MIT"
CMD ["python", "-m", "uvicorn", "dashboard:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--log-level", "warning"]